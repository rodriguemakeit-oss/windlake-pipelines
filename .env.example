# Copy this file to .env.preprod or .env.prod and fill in real values
# Usage: make <target>            (defaults to ENV=preprod, loads .env.preprod)
#        ENV=prod make <target>   (loads .env.prod)

# Databricks CLI profile (configured via `databricks auth login`)
PROFILE=preprod
# Your Databricks user email
USER_EMAIL=contributor@example.com

# Unity Catalog
CATALOG=ltsa_dev
SCHEMA=silver
REPORTS_VOLUME=/Volumes/ltsa_dev/raw/maintainer_reports
DATA_VOLUME=/Volumes/ltsa_dev/silver/genai_data

# Azure Document Intelligence
AZURE_DI_ENDPOINT=https://your-di-resource.cognitiveservices.azure.com
AZURE_DI_KEY=your-di-key

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_KEY=your-openai-key

# Jira (portfolio internal — Personal Access Token, used by `make jira-comment`)
JIRA_URL=https://service.example.invalid
JIRA_TOKEN=

# GitHub Enterprise (portfolio — Personal Access Token with `repo` scope, used by `make pr`)
GH_TOKEN=
